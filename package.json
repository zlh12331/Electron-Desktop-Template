{
  "name": "electron-desktop-template",
  "version": "0.1.0",
  "description": "Electron Desktop Template - 生产级 Electron 桌面应用模板（Windows / macOS / Linux）",
  "author": "zlh12331",
  "repository": {
    "type": "git",
    "url": "https://github.com/zlh12331/Electron-Desktop-Template.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-rebuild.mjs",
    "dev": "electron-vite dev -w",
    "dev:web": "vite --config vite.web.config.ts --mode web",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build && tsc -p scripts/tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck:watch": "tsc --build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip --include files,dependencies,devDependencies,binaries,exports,types",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:i18n": "tsx scripts/check-i18n.ts --strict",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:native-arch": "tsx scripts/check-native-arch.ts",
    "check:compiler": "tsx scripts/check-compiler.ts",
    "check:devtools": "tsx scripts/check-devtools.ts",
    "check:static": "pnpm check:tokens && pnpm check:i18n && pnpm check:comments && pnpm check:tsdoc && pnpm check:file-size && pnpm check:functions && pnpm check:complexity && pnpm check:coverage-floors && pnpm check:observability-config && pnpm check:observability-slo && pnpm check:docs && pnpm check:docs-scripts && pnpm check:docs-contracts && pnpm check:test-boundary && pnpm check:csp-hash && pnpm check:css-vars && pnpm check:animations && pnpm check:ui-consistency && pnpm check:brand",
    "check:csp-hash": "tsx scripts/check-csp-hash.ts",
    "check:css-vars": "tsx scripts/check-css-vars.ts",
    "check:animations": "tsx scripts/check-animations.ts",
    "check:changelog-polish": "tsx scripts/check-changelog-polish.ts",
    "release:draft": "tsx scripts/changelog-draft.ts",
    "check:ui-consistency": "tsx scripts/check-ui-consistency.ts",
    "check:tsdoc": "tsx scripts/check-tsdoc.ts",
    "check:secrets": "gitleaks dir . --redact --no-banner",
    "check:secrets-git": "tsx scripts/check-secrets-git.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:release-anchor": "tsx scripts/check-release-anchor.ts",
    "check:release-pr-scope": "tsx scripts/check-release-pr-scope.ts",
    "check:coverage-floors": "tsx scripts/check-coverage-floors.ts",
    "coverage-floors:tighten": "tsx scripts/check-coverage-floors.ts --tighten",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "tsx scripts/check-tokens-sync.ts",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "check:docs": "pnpm --filter @code-agent/typedoc-docs run check",
    "check:docs-scripts": "tsx scripts/check-docs-scripts.ts",
    "check:docs-contracts": "tsx scripts/check-docs-contracts.ts",
    "check:file-size": "tsx scripts/check-file-size.ts",
    "check:functions": "biome lint --only=complexity/noExcessiveLinesPerFunction --reporter=json src | tsx scripts/check-functions.ts",
    "check:complexity": "biome lint --only=complexity/noExcessiveCognitiveComplexity --reporter=json src | tsx scripts/check-complexity.ts",
    "check:comments": "tsx scripts/check-comments.ts",
    "depcruise": "pnpm --filter @code-agent/depcruise run check",
    "format": "biome format --write .",
    "test": "pnpm -r --filter \"@code-agent/*\" --filter \"!@code-agent/typedoc-docs\" run test && pnpm test:main && pnpm test:renderer && pnpm test:integration && pnpm test:scripts",
    "verify:local": "pnpm check:secrets-git && pnpm typecheck && pnpm lint && pnpm check:static && pnpm tokens:check && pnpm knip && pnpm depcruise && pnpm check:schema-drift && pnpm audit:registry && pnpm test",
    "audit:registry": "audit-ci --config .nsprc --moderate --high --critical --report-type summary --registry https://registry.npmjs.org",
    "verify:local:full": "pnpm verify:local && pnpm build && pnpm check:bundle && pnpm check:compiler && pnpm check:devtools && pnpm test:e2e && pnpm test:e2e:electron && pnpm build:win:x64 && pnpm check:native-arch && pnpm test:smoke",
    "test:scripts": "vitest run --root scripts",
    "test:main": "vitest run --root src/main --silent=passed-only",
    "test:main:watch": "vitest --root src/main",
    "test:renderer": "vitest run --root src/renderer --silent=passed-only",
    "test:renderer:watch": "vitest --root src/renderer",
    "test:e2e": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts",
    "test:a11y": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts e2e/a11y.spec.ts",
    "test:e2e:electron": "playwright test --config e2e/playwright.electron.config.ts",
    "test:smoke": "playwright test --config e2e/playwright.smoke.config.ts",
    "test:coverage": "pnpm --filter \"@code-agent/shared\" exec vitest run --coverage && pnpm test:main --coverage && pnpm test:renderer --coverage && pnpm coverage:settings --check && pnpm check:coverage-scope && pnpm check:critical-coverage",
    "coverage:settings": "tsx scripts/measure-settings-coverage.ts",
    "audit": "audit-ci --config .nsprc --moderate --high --critical --report-type summary --registry https://registry.npmjs.org",
    "prepare:build-info": "node scripts/generate-build-info.mjs",
    "build:dist": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --publish never",
    "build:win": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --win --x64 --arm64 --publish never",
    "build:mac": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --mac --x64 --arm64 --publish never",
    "build:linux": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --linux --x64 --arm64 --publish never",
    "build:win:x64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --win --x64 --publish never",
    "build:win:arm64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --win --arm64 --publish never",
    "build:mac:x64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --mac --x64 --publish never",
    "build:mac:arm64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --mac --arm64 --publish never",
    "build:linux:x64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --linux --x64 --publish never",
    "build:linux:arm64": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --linux --arm64 --publish never",
    "build:all": "pnpm prepare:build-info && pnpm build:instrumented && electron-builder --publish never",
    "build:instrumented": "pnpm build && pnpm sentry:sourcemaps",
    "sentry:sourcemaps": "tsx scripts/sentry-sourcemaps.ts",
    "sentry:debug-files": "tsx scripts/sentry-debug-files.ts",
    "observability:doctor": "tsx scripts/observability-doctor.ts",
    "observability:smoke": "tsx scripts/observability-smoke.ts",
    "observability:collector-smoke": "tsx scripts/collector-smoke.ts",
    "check:observability-config": "tsx scripts/check-observability-config.ts",
    "check:observability-slo": "tsx scripts/check-observability-slo.ts",
    "scaffold:ipc": "tsx scripts/scaffold/scaffold-ipc.ts",
    "init:template": "tsx scripts/init-template.ts",
    "acceptance:derived": "tsx scripts/acceptance-derived.ts",
    "acceptance:nsis": "tsx scripts/acceptance-nsis.ts",
    "analyze:bundle": "cross-env ANALYZE_BUNDLE=1 pnpm build",
    "docs:types": "pnpm --filter @code-agent/typedoc-docs run gen",
    "prepare": "husky",
    "test:integration": "vitest run --root tests/integration --silent=passed-only",
    "check:test-boundary": "tsx scripts/check-test-boundary.ts",
    "sbom:generate": "cdxgen -t pnpm --spec-version 1.6 -o bom.json",
    "brand:sync": "node scripts/generate-brand.mjs",
    "check:brand": "tsx scripts/check-brand.ts",
    "check:coverage-scope": "tsx scripts/check-coverage-scope.ts",
    "check:critical-coverage": "tsx scripts/check-critical-coverage.ts",
    "test:visual": "cross-env E2E_MODE=true playwright test --config e2e/playwright.visual.config.ts"
  },
  "lint-staged": {
    "{src,scripts,packages,tools,e2e,tests}/**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.0.7",
    "@biomejs/biome": "^2.5.15",
    "@code-agent/shared": "workspace:*",
    "@code-agent/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cyclonedx/cdxgen": "^12.8.5",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/cli": "3.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "audit-ci": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-cli": "^1.75.1",
    "js-yaml": "5.4.3",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "oxc-parser": "0.152.0",
    "oxc-transform-react": "^0.152.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sonner": "^2.0.8",
    "style-dictionary": "^5.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@sentry/electron": "8.3.0",
    "@sentry/node-native": "11.8.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "undici": "^8.11.2",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.6"
  }
}
