# 环境变量模板（Electron 桌面端模板）
# ──────────────────────────────────────────────────────────────
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# .env 已在 .gitignore 中忽略，不会提交到仓库。主进程启动时用
# process.loadEnvFile() 加载（dev 与打包版均生效，取决于启动环境）。
#
# 说明：
# - 所有配置项均为可选，未配置时使用代码内默认值
# - 网络遥测默认 off；在设置页主动选择 error-only/full 并重启后才可能外发
# - APP_ENV_FILE 可指定环境文件；在启动环境中设置为空字符串可禁用文件加载
# - 凭据不通过 .env 管理：走应用内凭据存储（safeStorage 加密落 keychain.dat，
#   见设置页「凭据」分区）。.env 只承载本机开发期的非敏感开关

# ── Sentry（可选；DSN 未配置时错误上报完整 no-op） ──────────────
# 运行时环境变量优先于构建期注入的 DSN（electron.vite.config.ts 的 SENTRY_DSN）
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# 环境名（默认 packaged=production / dev=development）
# SENTRY_ENVIRONMENT="development"
# 覆盖 release（默认 {executableName}@{version}；必须与 source map 上传一致）
# SENTRY_RELEASE="electron-desktop-template@0.1.0"
# 仅构建/CI 使用：source map 上传凭据（运行时不需要）
# SENTRY_AUTH_TOKEN="<your-sentry-auth-token>"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="electron-desktop-template"
# 设为 1 时跳过 source map 上传（本地构建排障用）
# SENTRY_UPLOAD_DISABLED="1"
# 设为 1 时上传原生调试符号（CI 仓库变量；默认关闭）
# SENTRY_UPLOAD_DEBUG_FILES="1"

# ── OpenTelemetry（可选；未配置 OTLP 端点时仅 dev 用 Console trace） ──
# base URL：自动派生 /v1/traces、/v1/metrics、/v1/logs（也可用各信号专用变量覆盖）
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://127.0.0.1:4318/v1/metrics"
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://127.0.0.1:4318/v1/logs"
# 服务名（默认 {executableName}-prod / {executableName}-dev）
# OTEL_SERVICE_NAME="electron-desktop-template-dev"
# 根 span 采样率 0..1（默认 dev=1、prod=0.2；也接受 always_on / always_off）
# 使用本地 Collector 尾采样时需设为 1；已被头部丢弃的 trace 无法由 Collector 恢复
# OTEL_TRACES_SAMPLER_ARG="0.1"
# OTEL_TRACES_SAMPLER="parentbased_traceidratio"
# 日志导出最低级别 debug/info/warn/error（full 默认 info；error-only 固定 error）
# OTEL_LOG_LEVEL="info"
# info/debug 日志随机采样率 0..1（warn/error 永不采样；默认 1）
# OTEL_LOG_SAMPLE_RATIO="1"
# 非 error 日志每分钟导出上限（0 = 不限；默认 0）
# OTEL_LOG_MAX_PER_MINUTE="0"
# 指标导出间隔毫秒（默认 60000，范围 1000..600000）
# OTEL_METRIC_EXPORT_INTERVAL="60000"
# OTLP 请求头（逗号分隔 key=value；SigNoz Cloud ingestion key 等）
# OTEL_EXPORTER_OTLP_HEADERS="signoz-access-token=xxx"
# 排障：把 OTel SDK 的导出错误打到 stderr（默认关闭）
# OTEL_DIAG="1"

# ── 开发期开关（生产构建无效） ──────────────────────────────
# 自定义 userData 目录（默认 dev 重定向到仓库内 .electron-user-data/）
# APP_USER_DATA="D:/tmp/my-app-data"
# CDP 远程调试端口（默认 9222）
# APP_DEBUG_PORT="9222"
# 强制开启 dev 更新链路调试（真实访问 GitHub Releases，见 dev-app-update.yml）
# APP_DEV_UPDATE="1"
