{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "isolatedDeclarations": false,
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
