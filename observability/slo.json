{
  "version": 1,
  "updatedAt": "2026-10-24",
  "description": "模板默认 SLO/告警定义；后端配置（SigNoz/Sentry）按 id 建面板与告警。阈值是起步值，接入业务后按真实基线调整。",
  "slos": [
    {
      "id": "crash-free-sessions",
      "title": "Crash-free sessions",
      "source": "sentry",
      "metric": null,
      "aggregation": null,
      "target": 0.995,
      "unit": "ratio",
      "window": "7d",
      "severity": "critical",
      "description": "无崩溃会话占比 ≥99.5%",
      "alert": { "for": "1h", "condition": "< 0.99", "severity": "critical" }
    },
    {
      "id": "ipc-error-rate",
      "title": "IPC error rate",
      "source": "otel",
      "metric": "ipc.server.requests",
      "aggregation": "error-rate",
      "target": 0.005,
      "unit": "ratio",
      "window": "1h",
      "severity": "critical",
      "description": "IPC 请求错误率 ≤0.5%",
      "alert": { "for": "5m", "condition": "> 0.05", "severity": "critical" }
    },
    {
      "id": "ipc-p95-latency",
      "title": "IPC p95 latency",
      "source": "otel",
      "metric": "ipc.server.request.duration",
      "aggregation": "p95",
      "target": 0.3,
      "unit": "seconds",
      "window": "1h",
      "severity": "warning",
      "description": "IPC 请求 p95 ≤300ms",
      "alert": { "for": "10m", "condition": "> 1", "severity": "warning" }
    },
    {
      "id": "startup-p95",
      "title": "Startup p95",
      "source": "otel",
      "metric": "app.startup.duration",
      "aggregation": "p95",
      "target": 3,
      "unit": "seconds",
      "window": "1h",
      "severity": "warning",
      "description": "启动到窗口 p95 ≤3s",
      "alert": { "for": "15m", "condition": "> 5", "severity": "warning" }
    },
    {
      "id": "update-check-failure",
      "title": "Update check failure rate",
      "source": "otel",
      "metric": "app.update.events",
      "aggregation": "error-rate",
      "target": 0.02,
      "unit": "ratio",
      "window": "24h",
      "severity": "warning",
      "description": "更新检查失败率 ≤2%",
      "alert": { "for": "1h", "condition": "> 0.05", "severity": "warning" }
    },
    {
      "id": "update-download-p95",
      "title": "Update download p95",
      "source": "otel",
      "metric": "app.update.download.duration",
      "aggregation": "p95",
      "target": 10,
      "unit": "seconds",
      "window": "24h",
      "severity": "warning",
      "description": "更新下载 p95 ≤10s（按包体调整）",
      "alert": { "for": "1h", "condition": "> 30", "severity": "warning" }
    },
    {
      "id": "db-backup-success",
      "title": "Database backup success rate",
      "source": "otel",
      "metric": "app.db.backup",
      "aggregation": "error-rate",
      "target": 0.99,
      "unit": "ratio",
      "window": "24h",
      "severity": "warning",
      "description": "数据库备份成功率 ≥99%",
      "alert": { "for": "1h", "condition": "> 0.05", "severity": "warning" }
    },
    {
      "id": "event-loop-p99",
      "title": "Event loop p99 delay",
      "source": "otel",
      "metric": "nodejs.eventloop.delay",
      "aggregation": "p99",
      "target": 0.2,
      "unit": "seconds",
      "window": "5m",
      "severity": "critical",
      "description": "主进程事件循环 p99 ≤200ms",
      "alert": { "for": "5m", "condition": "> 2", "severity": "critical" }
    },
    {
      "id": "web-vitals-lcp",
      "title": "LCP p75",
      "source": "otel",
      "metric": "web_vitals.lcp",
      "aggregation": "p75",
      "target": 2.5,
      "unit": "seconds",
      "window": "24h",
      "severity": "warning",
      "description": "LCP p75 ≤2.5s",
      "alert": { "for": "30m", "condition": "> 4", "severity": "warning" }
    },
    {
      "id": "web-vitals-inp",
      "title": "INP p75",
      "source": "otel",
      "metric": "web_vitals.inp",
      "aggregation": "p75",
      "target": 0.2,
      "unit": "seconds",
      "window": "24h",
      "severity": "warning",
      "description": "INP p75 ≤200ms",
      "alert": { "for": "30m", "condition": "> 0.5", "severity": "warning" }
    },
    {
      "id": "web-vitals-cls",
      "title": "CLS p75",
      "source": "otel",
      "metric": "web_vitals.cls",
      "aggregation": "p75",
      "target": 0.1,
      "unit": "score",
      "window": "24h",
      "severity": "warning",
      "description": "CLS p75 ≤0.1",
      "alert": { "for": "30m", "condition": "> 0.25", "severity": "warning" }
    }
  ]
}
