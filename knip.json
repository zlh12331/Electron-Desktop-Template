{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/renderer/index.html",
        "src/renderer/dev/mock-api.ts",
        "src/renderer/test/setup.ts",
        "src/renderer/test/setup-lang.ts",
        "src/**/vitest.config.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "*.config.{js,ts}",
        ".husky/pre-commit",
        ".husky/pre-push"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "*.{ts,js}"
      ],
      "paths": {
        "@/*": ["src/renderer/*"]
      }
    }
  },
  "ignoreBinaries": ["gitleaks", "reg.exe"],
  "ignoreDependencies": ["@electron/rebuild", "@sentry/cli", "tslib"],
  "ignoreIssues": {
    "src/renderer/components/ui/**": ["exports"],
    "src/renderer/lib/dialog-actions.ts": ["files"],
    "src/renderer/components/common/EmptyState.tsx": ["files"],
    "src/renderer/components/common/MotionReveal.tsx": ["files"],
    "src/main/infra/invalidation/invalidation.ts": ["files"]
  }
}
