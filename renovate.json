{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Shanghai",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "1 day",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Electron patch/minor 独立成组：升级后必须重编原生模块并跑 native-arch/smoke",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "electron runtime",
      "groupSlug": "electron-runtime",
      "labels": ["dependencies", "electron"]
    },
    {
      "description": "非 major 更新归一组，减少 PR 数量；Electron 已单独分组",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": [
        "!electron"
      ]
    },
    {
      "description": "主版本一律人工确认：TypeScript / Vite / electron-vite / React Router / i18next / Electron",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "electron major 需单独排期（主框架升级影响面大）",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "react-query 与 devtools 对等口径：双包必须同 PR 同版本升级（devtools peer 绑定 react-query 主版本，错峰单独升级会破坏 peer 约束）",
      "matchPackageNames": ["@tanstack/react-query", "@tanstack/react-query-devtools"],
      "groupName": "tanstack react-query pair",
      "groupSlug": "tanstack-react-query-pair"
    }
  ]
}
